# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files (we don't commit these for modules/components)
.terraform.lock.hcl

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# Vendored components for local linting (if using vendor.yaml at root)
account-map/
